{
  "name": "dshx-side-chat",
  "version": "1.1.0",
  "private": true,
  "description": "Claude-style side chat for DeepSeek Harness: ask a quick question about the current conversation in a right-sidebar panel (Ctrl+; or /btw). The answer sees the main conversation's full context; nothing is written back to it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "author": "callaumyan-design",
  "license": "MIT",
  "homepage": "https://github.com/callaumyan-design/dshx-side-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callaumyan-design/dshx-side-chat.git"
  },
  "bugs": {
    "url": "https://github.com/callaumyan-design/dshx-side-chat/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
